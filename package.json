{
  "name": "monitor-theme-dys",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:e2e": "npm run e2e",
    "preview": "vite preview",
    "gen:map": "node scripts/gen-map.mjs",
    "perf": "node tests/perf/measure.mjs --out docs/perf/current.json",
    "perf:compare": "node tests/perf/compare.mjs docs/perf/baseline-v1.6.json docs/perf/current.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "country-flag-icons": "^1.5.0",
    "simple-icons": "^14.12.3",
    "tailwindcss": "^4.1.0",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.0.0",
    "d3-geo": "^3.1.1",
    "jsdom": "^26.0.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "world-atlas": "^2.0.2"
  }
}
