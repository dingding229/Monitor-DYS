{
  "name": "DYS",
  "short": "dys",
  "description": "紧凑卡片风格 Monitor 状态主题：流量总览、国家地图、延迟丢包、搜索排序、访客气泡，Svelte 5 + uPlot",
  "version": "1.5.1",
  "author": "dingding229",
  "url": "https://github.com/dingding229/Monitor-DYS",
  "config": [
    {
      "type": "title",
      "label": "外观"
    },
    {
      "key": "layout",
      "type": "select",
      "default": "grid",
      "label": "默认布局",
      "help": "访客可在页面上切换，自己的选择保存在浏览器",
      "options": [
        {
          "value": "grid",
          "label": "卡片"
        },
        {
          "value": "table",
          "label": "列表"
        }
      ]
    },
    {
      "key": "card_size",
      "type": "select",
      "default": "compact",
      "label": "卡片尺寸",
      "help": "紧凑：宽屏每行 4–5 张；标准：每行 3–4 张",
      "options": [
        {
          "value": "compact",
          "label": "紧凑"
        },
        {
          "value": "standard",
          "label": "标准"
        }
      ]
    },
    {
      "key": "accent",
      "type": "string",
      "default": "#10b981",
      "label": "主题色",
      "help": "CSS 颜色值，如 #10b981；无效值回退默认"
    },
    {
      "type": "title",
      "label": "首页"
    },
    {
      "key": "show_summary",
      "type": "boolean",
      "default": true,
      "label": "显示总览卡片",
      "help": "服务器数量、实时上行、实时下行、累计流量、累计上行、累计下行六格"
    },
    {
      "key": "show_map",
      "type": "boolean",
      "default": true,
      "label": "显示节点地图",
      "help": "点阵世界地图，按国家标出节点与在线数"
    },
    {
      "key": "show_ping",
      "type": "boolean",
      "default": true,
      "label": "首页显示延迟与丢包",
      "help": "按需请求可见节点最近 1 小时的 Ping 汇总，每 60 秒刷新；关闭后不发请求"
    },
    {
      "key": "show_search",
      "type": "boolean",
      "default": true,
      "label": "显示搜索",
      "help": "按名称、地区、系统、公开备注搜索"
    },
    {
      "key": "show_sort",
      "type": "boolean",
      "default": true,
      "label": "显示排序选择"
    },
    {
      "key": "announcement",
      "type": "text",
      "default": "",
      "label": "公告",
      "help": "显示在页面顶部，按纯文本渲染"
    },
    {
      "type": "title",
      "label": "费用"
    },
    {
      "key": "show_billing",
      "type": "boolean",
      "default": true,
      "label": "显示价格与到期"
    },
    {
      "key": "expiry_warning_days",
      "type": "number",
      "default": 7,
      "min": 1,
      "max": 365,
      "label": "到期提醒天数",
      "help": "剩余天数小于等于此值时显示提醒色"
    },
    {
      "type": "title",
      "label": "访客与页脚"
    },
    {
      "key": "visitor_info_enabled",
      "type": "boolean",
      "default": true,
      "label": "显示底部访客气泡",
      "help": "显示访客出口地区与浏览器，点击展开设备、IP、运营商和访问时间。开启后访客浏览器会向 api.ip.sb 请求定位（失败时用 ipwho.is）；关闭后不发请求"
    },
    {
      "key": "footer",
      "type": "string",
      "default": "",
      "label": "页脚文字 / 备案号"
    },
    {
      "key": "footer_url",
      "type": "string",
      "default": "",
      "label": "页脚链接",
      "help": "仅接受 http/https 地址；无效时只显示文字"
    },
    {
      "type": "title",
      "label": "高级"
    },
    {
      "key": "poll_interval",
      "type": "number",
      "default": 5,
      "min": 2,
      "max": 60,
      "label": "降级轮询间隔（秒）",
      "help": "WebSocket 不可用时轮询 /api/nodes 的间隔"
    }
  ]
}
